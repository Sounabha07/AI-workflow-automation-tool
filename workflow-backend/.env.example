DATABASE_URL=postgresql://dag_user:dag_password@localhost:5432/dag_db
REDIS_URL=redis://localhost:6379/0
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
LOG_LEVEL=INFO
ENVIRONMENT=development

# Encrypts saved credentials (clients' own API keys) at rest. Required to
# save or use credentials. Generate once and keep it: changing it makes
# existing credentials unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Optional server-wide fallback for LLM blocks with no credential selected
# (handy for local dev). https://aistudio.google.com/apikey. Worker only.
GEMINI_API_KEY=
